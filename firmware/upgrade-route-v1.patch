+}
+
+
+bool StackChanAvatarDisplay::ShowRouteCard(const std::string& data)
+{
+    if (!setup_ui_called_) return false;
+    route_ui::Route route;
+    if (!route_ui::Parse(data, route)) return false;
+    DisplayLockGuard lock(this);
+    if (route_panel_) lv_obj_add_flag(route_panel_, LV_OBJ_FLAG_HIDDEN);
+    auto theme = static_cast<LvglTheme*>(current_theme_);
+    route_view_.Show(std::move(route), theme->text_font()->font());
+    return true;
 }
