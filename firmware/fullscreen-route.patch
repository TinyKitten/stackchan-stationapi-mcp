+// Persistent full-screen route, independent of speech and preview timeouts.
+bool StackChanAvatarDisplay::ShowRoute(const std::string& text)
+{
+    if (!setup_ui_called_ || text.empty() || text.size() > 4096 || text.find('\0') != std::string::npos) return false;
+    DisplayLockGuard lock(this);
+    if (route_panel_) lv_obj_delete(route_panel_);
+    route_panel_ = lv_obj_create(lv_layer_top());
+    lv_obj_set_size(route_panel_, LV_PCT(100), LV_PCT(100));
+    lv_obj_set_style_radius(route_panel_, 0, 0);
+    lv_obj_set_style_border_width(route_panel_, 0, 0);
+    lv_obj_set_style_pad_all(route_panel_, 10, 0);
+    lv_obj_set_style_bg_color(route_panel_, lv_color_hex(0x101820), 0);
+    lv_obj_set_style_bg_opa(route_panel_, LV_OPA_COVER, 0);
+    lv_obj_set_style_text_color(route_panel_, lv_color_white(), 0);
+    auto theme = static_cast<LvglTheme*>(current_theme_);
+    lv_obj_set_style_text_font(route_panel_, theme->text_font()->font(), 0);
+    lv_obj_remove_flag(route_panel_, LV_OBJ_FLAG_SCROLLABLE);
+    auto close = lv_button_create(route_panel_);
+    lv_obj_set_size(close, 90, 38);
+    lv_obj_align(close, LV_ALIGN_TOP_RIGHT, 0, 0);
+    auto caption = lv_label_create(close);
+    lv_label_set_text(caption, "閉じる");
+    lv_obj_center(caption);
+    lv_obj_add_event_cb(close, [](lv_event_t* event) {
+        auto self = static_cast<StackChanAvatarDisplay*>(lv_event_get_user_data(event));
+        // Event callbacks already hold the LVGL lock.
+        lv_obj_add_flag(self->route_panel_, LV_OBJ_FLAG_HIDDEN);
+    }, LV_EVENT_CLICKED, this);
+    auto heading = lv_label_create(route_panel_);
+    lv_label_set_text(heading, "経路案内");
+    lv_obj_align(heading, LV_ALIGN_TOP_LEFT, 0, 7);
+    auto body = lv_obj_create(route_panel_);
+    lv_obj_set_pos(body, 0, 46);
+    lv_obj_set_size(body, LV_PCT(100), 174);
+    lv_obj_set_style_bg_opa(body, LV_OPA_TRANSP, 0);
+    lv_obj_set_style_border_width(body, 0, 0);
+    lv_obj_set_style_pad_all(body, 0, 0);
+    lv_obj_set_scroll_dir(body, LV_DIR_VER);
+    auto label = lv_label_create(body);
+    lv_obj_set_width(label, LV_PCT(100));
+    lv_label_set_long_mode(label, LV_LABEL_LONG_WRAP);
+    lv_label_set_text(label, text.c_str());
+    return true;
+}
+
+void StackChanAvatarDisplay::HideRoute()
+{
+    DisplayLockGuard lock(this);
+    if (route_panel_) lv_obj_add_flag(route_panel_, LV_OBJ_FLAG_HIDDEN);
+}
